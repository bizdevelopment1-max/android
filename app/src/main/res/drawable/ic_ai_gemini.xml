        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="50"
                android:centerY="50">
                <item android:offset="0.0" android:color="#FF2E7DF2" />
                <item android:offset="0.25" android:color="#FF2DA94E" />
                <item android:offset="0.5" android:color="#FFF4B400" />
                <item android:offset="0.75" android:color="#FFEA4335" />
                <item android:offset="1.0" android:color="#FF2E7DF2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
